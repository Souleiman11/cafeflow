# CaféFlow local development configuration.
# DEVELOPMENT ONLY - these values are for `docker compose up` on a developer machine.
# Copy to `.env` to override. Never commit `.env`. Never reuse these values elsewhere.

# PostgreSQL
POSTGRES_DB=cafeflow
POSTGRES_USER=cafeflow
POSTGRES_PASSWORD=cafeflow_dev_only

# Redis
REDIS_PASSWORD=redis_dev_only

# Published host ports (all bound to 127.0.0.1)
FRONTEND_PORT=4200
BACKEND_PORT=8080
ML_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
